# mobile-bench/dioxus-wallet/web/: vendored upstream JS/WASM is
# rebuilt by `npm run build` from the local checkout. Tracked
# sources are the entry/shim files under web/src/ and the build
# scripts; everything else is generated.
mobile-bench/dioxus-wallet/assets/web/pkg/
mobile-bench/dioxus-wallet/assets/web/midnight-did.js
mobile-bench/dioxus-wallet/assets/web/midnight-did.js.map
# Old esbuild loader=file artifacts (replaced by the mn-pkg://
# vendor pipeline). Regenerated by running build.mjs.
mobile-bench/dioxus-wallet/assets/web/*_wasm_bg-*.wasm

# Claude Code session state — local to a worktree, not part of
# the repo.
.claude/

# Android wrapper build artefacts. The `.so` is regenerated by
# `cargo ndk -t arm64-v8a -o android/app/src/main/jniLibs build
# --release -p dioxus-wallet --lib` per the deploy guide. Including
# it would bloat the repo by ~130 MB (release build, with the
# embedded `mn-pkg://` tree linked in) and exceed GitHub's
# per-file push ceiling.
mobile-bench/dioxus-wallet/android/.gradle/
mobile-bench/dioxus-wallet/android/build/
mobile-bench/dioxus-wallet/android/app/build/
mobile-bench/dioxus-wallet/android/local.properties
mobile-bench/dioxus-wallet/android/app/src/main/jniLibs/*/lib*.so

# iOS wrapper build artefacts. `xcodegen generate` rebuilds the
# .xcodeproj from project.yml on demand; the vendored .dylib is
# regenerated by `cargo build --target aarch64-apple-ios-sim
# --release -p dioxus-wallet --lib`. Both are too big to track
# (the `.dylib` is ~120 MB for the same reason as the Android
# `.so`).
mobile-bench/dioxus-wallet/ios/DioxusWallet.xcodeproj/
mobile-bench/dioxus-wallet/ios/App/libdioxuswalletmain.dylib

# Node modules under the JS bundle source tree (large, generated
# by `npm install` in `web/`).
mobile-bench/dioxus-wallet/web/node_modules/

