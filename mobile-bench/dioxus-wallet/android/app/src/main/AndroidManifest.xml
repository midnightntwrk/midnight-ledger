<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera permission for the WebView-based QR scanner. Wry's
         `RustWebChromeClient.onPermissionRequest` handles the runtime
         prompt for `android.webkit.resource.VIDEO_CAPTURE` and grants
         it iff this manifest permission is also defined. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <application android:hasCode="true" android:supportsRtl="true" android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name" android:theme="@style/AppTheme"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <!--
            Orientation: pinned to portrait. The WebView+NativeActivity surface
            doesn't survive a config-driven recreate; rotating to landscape used
            to white-screen the app and force a restart. Pinning portrait lets us
            drop landscape from the surface contract entirely.

            `configChanges` is broadened to cover screenSize / smallestScreenSize /
            screenLayout / uiMode / density too — Android otherwise recreates the
            activity on dark-mode toggle, font-size change, and split-screen
            resize, each of which would re-trigger the white-screen path.
        -->
        <activity android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="dioxuswalletmain" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
