<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Empty manifest — the @midnight-ntwrk/react-native-prover package
        is a pure native module, no Activities / Services / Receivers.

        Per the architecture doc §13.5, this is **Option A** (UniFFI
        same-process on both platforms). No `:proverProcess` Service
        declaration here; the prover runs in the host RN app's main
        process. A prover OOM crashes the host app.

        If a downstream consumer wants Option B (separate-process
        isolation), they declare their own Service in their app
        manifest with `android:process=":proverProcess"` and call into
        the JNI library from that Service instead of the main process.
    -->
</manifest>
