// UniFFI definition file for the Midnight RN prover bindings.
//
// Every type / function declared here gets auto-generated bindings
// in Swift (for iOS) and Kotlin (for Android) via `ubrn build {ios,android}`,
// plus TypeScript surface via `uniffi-bindgen-react-native`. Keep this
// file in lockstep with the `#[uniffi::export]` annotations in `lib.rs`.

namespace midnight_prover {
    // Library version baked at build time. Lets the TS side log
    // which Rust core it's actually loaded against (useful when
    // a downstream RN app pins one version and a native module
    // bundles a different one).
    string library_version();

    // Run a single bench prove at the requested `k`. Synchronous
    // from the FFI side — the platform layer (Swift / Kotlin) is
    // expected to call this from a background thread / Coroutine /
    // Promise so the JS thread never blocks.
    [Throws=ProverError]
    ProveResult prove(u32 k, ProveOptions opts);

    // ─── Wallet / DID (gated on `wallet` Cargo feature) ───
    // Resolve a Midnight DID via the indexer. Returns the resolved
    // DID document as a JSON string.
    [Throws=WalletError]
    string did_resolve(string network, string did);

    // EXPLICITLY NOT IMPLEMENTED YET. Always returns
    // `WalletError::NotImplemented` with a message pointing at
    // the integration plan.
    [Throws=WalletError]
    string did_deploy(Wallet wallet, string label);

    [Throws=WalletError]
    string did_update_aka(Wallet wallet, string did, string new_aka);

    [Throws=WalletError]
    string did_deactivate(Wallet wallet, string did);
};

// Options for a benchmark prove call. Mirrors `RunOpts` from
// `contract-benchmark` but flattened into UniFFI-friendly types
// (no Option<PathBuf>; the TS side passes an empty string if it
// doesn't want to override the SRS cache dir).
dictionary ProveOptions {
    // RNG seed. 0 = use the library default (a fixed value for
    // reproducible runs across the same circuit shape).
    u64 seed;

    // Skip the verifier check after proving. The Bench tab's
    // "skipped" cells at k > 14 happen because the embedded
    // PARAMS_VERIFIER is only k=14; setting this to false lets
    // the caller short-circuit verification at any k.
    boolean verify_after;

    // Where to cache BLS SRS files. Empty string = use the
    // standard MIDNIGHT_PP / XDG_CACHE_HOME resolution. The
    // mobile entry points (Android `main` + iOS `start_app`)
    // already set MIDNIGHT_PP at process start so most callers
    // can leave this empty.
    string cache_dir;

    // Whether to reuse cached (ProverKey, VerifierKey) pairs.
    // Default `true` matches the wallet's hot-path behaviour;
    // set `false` for the cold-keygen-per-row benchmark mode.
    boolean cache_keys;
};

// Outcome of a benchmark prove call. Times are in milliseconds
// because UniFFI's Duration support is platform-flaky and
// integer milliseconds round-trip cleanly through JSI's
// `Uint8Array` / `BigInt` plumbing.
dictionary ProveResult {
    u32 k;
    u32 realized_k;
    u32 hash_chain_len;
    u64 rows;
    u64 keygen_ms;
    u64 prove_ms;
    // None = skipped (k > MAX_VERIFIABLE_K) or verify_after=false.
    u64? verify_ms;
    boolean? verified;
    u64 proof_bytes;
};

[Error]
enum ProverError {
    "OutOfRange",
    "ParamsUnavailable",
    "KeygenFailed",
    "ProveFailed",
    "VerifyFailed",
    "Io",
    "Internal",
};

// ─── Wallet / keys / DID surface (gated on the `wallet` Cargo feature) ───

[Error]
enum WalletError {
    "NotImplemented",   // explicitly not-yet (e.g. DID write)
    "AlreadyExists",
    "NotFound",
    "Io",
    "Crypto",
    "Network",
    "Internal",
};

// Information about one stored key. Mirrors `secret_storage::
// types::StoredKeyMeta` from wallet-core, flattened for UniFFI.
dictionary KeyInfo {
    // Opaque handle — pass back to sign / get_public / delete.
    string key_ref;
    // E.g. "Ed25519", "JubJubSchnorr".
    string algorithm;
    // RFC3339 timestamp.
    string created_at;
    // Optional user-facing label (e.g. "DID maintenance key").
    string? label;
    // JSON-encoded JWK. Apps that want the raw bytes can parse
    // the JWK; keeping it as a string avoids mirroring 5 fields
    // across the FFI boundary.
    string public_key_jwk;
};

// Network the wallet targets. Mirrors `base_crypto::Network`
// but flattened to a string discriminant for UniFFI.
//   "main"     | "preprod" | "testnet" | "regtest"
// The Rust side maps "preprod" → Network::Preprod, etc., and
// returns a clear error on unknown strings.

// A handle to an opened wallet store. UniFFI represents this as
// an Arc<Wallet> on the Rust side; the TS side sees an opaque
// class with methods. The `wallet_open` constructor returns a
// fresh handle each time.
interface Wallet {
    // Open or create the wallet's underlying redb-backed
    // secret-store file. The first wallet created in the file
    // is bound to this handle's wallet_id. If the file already
    // exists, the passphrase must match the one used to create it.
    //
    // `label` is a human-readable wallet name written into the
    // store's metadata; not exposed to the chain.
    //
    // `seed_bytes` must be exactly 32 bytes. Pass `null` to let
    // the FFI generate a random seed via the OS RNG; pass an
    // explicit seed for restore-from-mnemonic flows.
    [Throws=WalletError]
    constructor(string path, string passphrase, string label, string network, sequence<u8>? seed_bytes);

    // List every key stored under this wallet.
    [Throws=WalletError]
    sequence<KeyInfo> list_keys();

    // Generate a new key in this wallet. `algorithm` must be
    // one of the supported curves — currently "JubjubSchnorr"
    // for DID maintenance keys; more algorithms surface as
    // wallet-core gains support.
    [Throws=WalletError]
    KeyInfo generate_key(string algorithm, string? label);

    // Look up the public key for a stored key reference. Returns
    // the JWK as a JSON string. Throws `NotFound` if `key_ref`
    // doesn't resolve.
    [Throws=WalletError]
    string get_public_key_jwk(string key_ref);

    // Sign `payload` with the secret behind `key_ref`. The
    // signature format depends on the key's algorithm —
    // documented per-algorithm in wallet-core.
    [Throws=WalletError]
    sequence<u8> sign(string key_ref, sequence<u8> payload);

    // Permanently delete `key_ref` from the store. Throws
    // `NotFound` if the key doesn't exist; idempotent on
    // repeated calls only by checking first.
    [Throws=WalletError]
    void delete_key(string key_ref);

    // The wallet's network ("main", "preprod", "testnet", "regtest").
    string network();
};

