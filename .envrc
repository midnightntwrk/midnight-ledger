# point out to users at commit time that commits need to be signed,
# not once they've done many commits and are trying to push a PR:
git config --local commit.gpgSign true
git config --local tag.gpgSign true

# Git 2.54+ supports the new [hook "<name>"] config syntax, which composes
# with globally-configured hooks. Older versions need core.hooksPath, which
# replaces any global hooks wholesale.
git_version=$(git --version | awk '{print $3}')
git_major=${git_version%%.*}
git_minor=${git_version#*.}; git_minor=${git_minor%%.*}
if [[ "$git_major" -gt 2 ]] || [[ "$git_major" -eq 2 && "$git_minor" -ge 54 ]]; then
  git config --local hook.dco.event commit-msg
  git config --local hook.dco.command "$PWD/.githooks/commit-msg"
else
  git config --local core.hooksPath .githooks
fi

use flake
