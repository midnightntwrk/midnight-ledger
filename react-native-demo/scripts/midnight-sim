#!/usr/bin/env bash
# midnight-sim — programmatic iOS Simulator driver for the
# MidnightDemoApp React Native host. Lets me iterate on the RN
# integration without round-tripping through the user for
# screenshots / state checks.
#
# Subcommands:
#   status          — one-line health summary (sim booted? Metro up? app installed? app running?)
#   metro           — start Metro detached if not already running
#   metro-kill      — stop Metro
#   build           — pod install + xcodebuild (Debug, iPhone 17 Pro sim)
#   install         — simctl install the .app
#   launch          — simctl terminate + launch with bundle URL pre-set
#   reload          — Cmd-R to the focused Simulator window
#   logs [N]        — tail last N lines of /tmp/metro.log (default 50)
#   logs-watch [s]  — tail Metro for s seconds, filtering for [GLOBAL-ERR] / [useBench] / errors
#   screen [path]   — screenshot the booted sim + sample top-center pixel; report "RED-ERROR" if visible
#   cycle           — full pipeline: build → install → launch → watch logs 30s → screenshot
#
# All long-running operations stream a short status line so I can
# see progress without polling. Long failures print the last
# `error:` line for quick diagnosis.

set -uo pipefail

APP_DIR="${MIDNIGHT_RN_HOST:-/tmp/midnight-rn-host/MidnightDemoApp}"
SIM_ID="${MIDNIGHT_SIM_ID:-76B99C81-BE72-4A93-A443-7F244723AAF3}"   # iPhone 17 Pro arm64
BUNDLE_ID="${MIDNIGHT_BUNDLE_ID:-org.reactjs.native.example.MidnightDemoApp}"
APP_BUNDLE="$APP_DIR/ios/build/Build/Products/Debug-iphonesimulator/MidnightDemoApp.app"
METRO_LOG="${MIDNIGHT_METRO_LOG:-/tmp/metro.log}"
SCREEN_OUT="${MIDNIGHT_SCREEN_OUT:-/tmp/midnight-sim-screen.png}"

log() { printf '\033[36m[midnight-sim]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[midnight-sim warn]\033[0m %s\n' "$*"; }
err() { printf '\033[31m[midnight-sim err]\033[0m %s\n' "$*" >&2; }

# ─── status ──────────────────────────────────────────────────────
cmd_status() {
  local sim_state metro_state app_installed_state app_running_state
  sim_state=$(xcrun simctl list devices booted 2>/dev/null | grep -q "$SIM_ID" && echo "booted" || echo "shutdown")
  if curl -s -o /dev/null -m 2 http://localhost:8081/status; then metro_state="up"; else metro_state="down"; fi
  if xcrun simctl get_app_container booted "$BUNDLE_ID" 2>/dev/null >/dev/null; then
    app_installed_state="yes"
  else
    app_installed_state="no"
  fi
  app_running_state=$(xcrun simctl spawn booted launchctl list 2>/dev/null | grep -c "$BUNDLE_ID" || true)
  log "sim=$sim_state  metro=$metro_state  app_installed=$app_installed_state  app_running=$app_running_state"
}

# ─── metro ───────────────────────────────────────────────────────
cmd_metro() {
  if curl -s -o /dev/null -m 2 http://localhost:8081/status; then
    log "Metro already running on :8081"
    return 0
  fi
  log "starting Metro detached → $METRO_LOG"
  ( cd "$APP_DIR" && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 yarn start ) > "$METRO_LOG" 2>&1 &
  local pid=$!
  log "Metro pid: $pid"
  # Wait up to 30s for Metro to be reachable
  local i=0
  while ! curl -s -o /dev/null -m 1 http://localhost:8081/status; do
    sleep 1
    i=$((i + 1))
    [ "$i" -ge 30 ] && { err "Metro didn't come up in 30s"; return 1; }
  done
  log "Metro ready"
}

cmd_metro_kill() {
  pkill -f "react-native start" && log "Metro killed" || warn "Metro wasn't running"
}

# ─── build ───────────────────────────────────────────────────────
cmd_build() {
  log "boot sim (if needed)"
  xcrun simctl boot "$SIM_ID" 2>/dev/null || true
  xcrun simctl bootstatus "$SIM_ID" 2>&1 | tail -2 || true

  # Force-relink the prover package so any package.json /
  # generated-code changes propagate into node_modules. yarn's
  # `file:` resolution caches aggressively and skips re-copy
  # when only the source-tree contents change.
  log "re-link prover package"
  rm -rf "$APP_DIR/node_modules/@midnight-ntwrk"
  ( cd "$APP_DIR" && yarn install ) 2>&1 | tail -2

  log "pod install (with RCT_NEW_ARCH_ENABLED=1)"
  ( cd "$APP_DIR/ios" && \
    LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 RCT_NEW_ARCH_ENABLED=1 pod install ) 2>&1 | tail -3

  log "xcodebuild Debug (this can take 5-10 min from cold)"
  local build_log=/tmp/midnight-build.log
  ( cd "$APP_DIR" && \
    LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 RCT_NEW_ARCH_ENABLED=1 xcodebuild \
      -workspace ios/MidnightDemoApp.xcworkspace \
      -scheme MidnightDemoApp \
      -configuration Debug \
      -sdk iphonesimulator \
      -destination "platform=iOS Simulator,id=$SIM_ID" \
      -derivedDataPath ios/build \
      GCC_PREPROCESSOR_DEFINITIONS='${inherited} RCT_NEW_ARCH_ENABLED=1' \
      build ) > "$build_log" 2>&1
  local rc=$?
  if [ $rc -ne 0 ] || ! [ -f "$APP_BUNDLE/MidnightDemoApp" ]; then
    err "build FAILED (rc=$rc). Last errors:"
    grep -E "error:|fatal" "$build_log" | tail -5
    return 1
  fi
  log "build OK — $APP_BUNDLE"
}

# ─── install ─────────────────────────────────────────────────────
cmd_install() {
  [ -d "$APP_BUNDLE" ] || { err "no .app at $APP_BUNDLE — run 'build' first"; return 1; }
  xcrun simctl install booted "$APP_BUNDLE" 2>&1 && log "installed"
}

# ─── launch ──────────────────────────────────────────────────────
cmd_launch() {
  xcrun simctl spawn booted defaults write "$BUNDLE_ID" RCT_jsLocation localhost 2>/dev/null || true
  xcrun simctl terminate booted "$BUNDLE_ID" 2>/dev/null || true
  local pid
  pid=$(xcrun simctl launch booted "$BUNDLE_ID" 2>&1 | grep -oE '[0-9]+$' || echo "?")
  log "launched (pid $pid)"
}

# ─── reload ──────────────────────────────────────────────────────
cmd_reload() {
  osascript -e 'tell application "Simulator" to activate' 2>/dev/null
  osascript -e 'tell application "System Events" to keystroke "r" using command down' 2>/dev/null
  log "Cmd-R sent"
}

# ─── logs ────────────────────────────────────────────────────────
cmd_logs() {
  local n=${1:-50}
  [ -f "$METRO_LOG" ] || { err "no metro log at $METRO_LOG"; return 1; }
  tail -"$n" "$METRO_LOG"
}

cmd_logs_watch() {
  local secs=${1:-30}
  [ -f "$METRO_LOG" ] || { err "no metro log at $METRO_LOG"; return 1; }
  log "watching Metro for ${secs}s; filtering errors / useBench traces"
  timeout "$secs" tail -f "$METRO_LOG" 2>/dev/null | \
    grep --line-buffered -E "GLOBAL-ERR|useBench|ERROR|error|prove|LOG  " | \
    head -60 || true
}

# ─── screen ──────────────────────────────────────────────────────
cmd_screen() {
  local out=${1:-$SCREEN_OUT}
  xcrun simctl io booted screenshot "$out" 2>/dev/null
  local w h
  w=$(sips -g pixelWidth "$out" 2>/dev/null | awk '/pixelWidth/ {print $2}')
  h=$(sips -g pixelHeight "$out" 2>/dev/null | awk '/pixelHeight/ {print $2}')
  local sample=""
  if command -v magick >/dev/null 2>&1; then
    # Sample a few diagnostic points and classify
    local top_color middle_color
    top_color=$(magick "$out" -format "%[pixel:p{$((w/2)),100}]" info: 2>/dev/null)
    middle_color=$(magick "$out" -format "%[pixel:p{$((w/2)),$((h/2))}]" info: 2>/dev/null)
    # Detect the red error overlay (Hermes red is ~rgb(207, 34, 46))
    if echo "$top_color" | grep -qE "srgb\(([2-9][0-9]{2}),"; then
      sample="RED-ERROR-OVERLAY (top=$top_color)"
    elif echo "$top_color" | grep -qE "srgb\((1[5-9]|2[0-9]),(1[5-9]|2[0-9]),(2[0-9]|3[0-9])"; then
      sample="DARK-UI (top=$top_color middle=$middle_color)"
    else
      sample="UNKNOWN (top=$top_color middle=$middle_color)"
    fi
  fi
  log "screen ${w}x${h} $sample → $out"
}

# ─── cycle ───────────────────────────────────────────────────────
cmd_cycle() {
  log "─── full cycle ───"
  cmd_metro || return 1
  cmd_build || return 1
  cmd_install || return 1
  cmd_launch || return 1
  log "sleeping 10s for bundle download + JS execution"
  sleep 10
  cmd_screen
  cmd_logs_watch 20
  log "─── cycle done ───"
  cmd_status
}

# ─── dispatch ────────────────────────────────────────────────────
sub=${1:-status}
shift || true
case "$sub" in
  status) cmd_status "$@" ;;
  metro) cmd_metro "$@" ;;
  metro-kill) cmd_metro_kill "$@" ;;
  build) cmd_build "$@" ;;
  install) cmd_install "$@" ;;
  launch) cmd_launch "$@" ;;
  reload) cmd_reload "$@" ;;
  logs) cmd_logs "$@" ;;
  logs-watch) cmd_logs_watch "$@" ;;
  screen) cmd_screen "$@" ;;
  cycle) cmd_cycle "$@" ;;
  help|-h|--help)
    grep '^#' "$0" | sed 's/^# //; s/^#//'
    ;;
  *)
    err "unknown subcommand: $sub"
    echo "available: status metro metro-kill build install launch reload logs logs-watch screen cycle"
    exit 1
    ;;
esac
